# DealSense backend configuration. Copy to .env and edit.

# Inference backend: auto | mlx | stub
DEALSENSE_INFERENCE_BACKEND=auto

# Local MLX models (Apple Silicon)
DEALSENSE_TEXT_MODEL=mlx-community/Meta-Llama-3-8B-Instruct-4bit
DEALSENSE_VISION_MODEL=mlx-community/Qwen2.5-VL-7B-Instruct-4bit

# Agent 4 RAG
DEALSENSE_EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5
DEALSENSE_QDRANT_PATH=./.qdrant

# Ledger
DEALSENSE_LEDGER_DB_PATH=./dealsense.db

# Agent 6 (only external call)
DEALSENSE_PANDADOC_API_KEY=
