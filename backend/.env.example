# Beacon backend configuration. Copy to .env and edit.

# Inference backend: auto | mlx | stub
BEACON_INFERENCE_BACKEND=auto

# Local MLX models (Apple Silicon)
BEACON_TEXT_MODEL=mlx-community/Meta-Llama-3-8B-Instruct-4bit
BEACON_VISION_MODEL=mlx-community/Qwen2.5-VL-7B-Instruct-4bit

# Agent 4 RAG
BEACON_EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5
BEACON_QDRANT_PATH=./.qdrant

# Ledger
BEACON_LEDGER_DB_PATH=./beacon.db

# Agent 6 (only external call)
BEACON_PANDADOC_API_KEY=
